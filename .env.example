# Postgres connection string used by the app and the Drizzle CLI.
DATABASE_URL=postgres://metacraft:metacraft@localhost:5432/metacraft

# SMTP server for outgoing email (Mailpit locally, Resend in production).
SMTP_HOST=localhost
SMTP_PORT=1025

# From-address used for outgoing email (magic links, etc.).
EMAIL_FROM=no-reply@metacraft.example

# Public base URL of the app, used to build absolute links (e.g. magic links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth token-signing secret. Required, minimum 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-generated-32-character-or-longer-secret

# Resend API key for outgoing email in production. Required only when
# NODE_ENV=production (Mailpit is used locally instead).
RESEND_API_KEY=replace-with-your-resend-api-key
